@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<http://lmms.io/lv2/fake-sidechain>
	a lv2:Plugin ;
	doap:name "Fake Sidechain" ;
	lv2:port [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 0 ; lv2:symbol "main_l" ; lv2:name "Main L" ;
	], [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 1 ; lv2:symbol "main_r" ; lv2:name "Main R" ;
	], [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 2 ; lv2:symbol "side_l" ; lv2:name "Side L" ;
		lv2:portProperty lv2:isSideChain ;
	], [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 3 ; lv2:symbol "side_r" ; lv2:name "Side R" ;
		lv2:portProperty lv2:isSideChain ;
	], [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 4 ; lv2:symbol "out_l" ; lv2:name "Out L" ;
	], [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 5 ; lv2:symbol "out_r" ; lv2:name "Out R" ;
	] .
